# Floating a workspace after layout toggles separates the moved wrapper layout from the empty
# workspace's retained split layout.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ layout toggle
workspace splitv focus=@
  window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ layout toggle all
workspace stacked focus=@
  window 1 0.000,0.064 1.000x0.936 hidden
  window 2 0.000,0.064 1.000x0.936

$ floating toggle
workspace splith focus=@0
  stacked 0.250,0.125 0.500x0.750
    window 1 0.250,0.189 0.500x0.686 hidden floating
    window 2 0.250,0.189 0.500x0.686 floating
