# A mapped view arranges its real parent container, even when fullscreen left it at zero size.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ move left
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ fullscreen toggle
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  window 2 0.000,0.000 1.000x1.000

$ layout toggle all
workspace splith focus=2
  splitv 0.000,0.000 0.000x0.000
    window 1 0.000,0.000 0.500x1.000 hidden
    window 2 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splitv 0.000,0.000 0.000x0.000
    window 1 0.000,0.000 0.000x0.000 hidden
    window 2 0.000,0.000 0.000x0.000
    window 3 0.000,0.000 0.000x0.000 hidden
