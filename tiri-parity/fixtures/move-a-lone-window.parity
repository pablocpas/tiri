# moving a lone window: nothing shifts, but the workspace turns to face the move
# recorded from sway version 1.11

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ move down
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ move right
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ move up
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ move left
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000
