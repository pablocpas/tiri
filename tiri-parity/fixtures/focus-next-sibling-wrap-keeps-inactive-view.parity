# Wrapped sibling focus descends to the view the seat remembers in the destination branch.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ move up
workspace splitv focus=2
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 1 0.000,0.500 1.000x0.500

$ open
workspace splitv focus=3
  window 2 0.000,0.000 1.000x0.333
  window 3 0.000,0.333 1.000x0.333
  splith 0.000,0.667 1.000x0.333
    window 1 0.000,0.667 1.000x0.333

$ move down
workspace splitv focus=3
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 3 0.000,0.500 0.500x0.500
    window 1 0.500,0.500 0.500x0.500

$ layout toggle all
workspace splitv focus=3
  window 2 0.000,0.000 1.000x0.500
  splitv 0.000,0.500 1.000x0.500
    window 3 0.000,0.500 1.000x0.250
    window 1 0.000,0.750 1.000x0.250

$ split toggle
workspace splitv focus=3
  window 2 0.000,0.000 1.000x0.500
  splitv 0.000,0.500 1.000x0.500
    splith 0.000,0.500 1.000x0.250
      window 3 0.000,0.500 1.000x0.250
    window 1 0.000,0.750 1.000x0.250

$ move right
workspace splith focus=3
  splitv 0.000,0.000 0.500x1.000
    window 2 0.000,0.000 0.500x0.500
    splitv 0.000,0.500 0.500x0.500
      window 1 0.000,0.500 0.500x0.500
  window 3 0.500,0.000 0.500x1.000

$ open
workspace splith focus=4
  splitv 0.000,0.000 0.334x1.000
    window 2 0.000,0.000 0.334x0.500
    splitv 0.000,0.500 0.334x0.500
      window 1 0.000,0.500 0.334x0.500
  window 3 0.334,0.000 0.334x1.000
  window 4 0.667,0.000 0.333x1.000

$ move down
workspace splitv focus=4
  splith 0.000,0.000 1.000x0.500
    splitv 0.000,0.000 0.500x0.500
      window 2 0.000,0.000 0.500x0.250
      splitv 0.000,0.250 0.500x0.250
        window 1 0.000,0.250 0.500x0.250
    window 3 0.500,0.000 0.500x0.500
  window 4 0.000,0.500 1.000x0.500

$ focus prev
workspace splitv focus=3
  splith 0.000,0.000 1.000x0.500
    splitv 0.000,0.000 0.500x0.500
      window 2 0.000,0.000 0.500x0.250
      splitv 0.000,0.250 0.500x0.250
        window 1 0.000,0.250 0.500x0.250
    window 3 0.500,0.000 0.500x0.500
  window 4 0.000,0.500 1.000x0.500

$ focus next sibling
workspace splitv focus=1
  splith 0.000,0.000 1.000x0.500
    splitv 0.000,0.000 0.500x0.500
      window 2 0.000,0.000 0.500x0.250
      splitv 0.000,0.250 0.500x0.250
        window 1 0.000,0.250 0.500x0.250
