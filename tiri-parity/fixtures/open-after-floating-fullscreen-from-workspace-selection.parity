# Opening with the workspace selected keeps Sway's inactive tiled insertion container after the
# former fullscreen view moves to floating.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ fullscreen toggle
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ split horizontal
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 0.500x1.000
      window 2 0.500,0.000 0.500x1.000

$ floating toggle
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating

$ open
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 2 0.000,0.000 0.500x1.000
      window 3 0.500,0.000 0.500x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating

$ open
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 2 0.000,0.000 0.334x1.000
      window 4 0.334,0.000 0.334x1.000
      window 3 0.667,0.000 0.333x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating

$ focus parent
workspace splith focus=@
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 2 0.000,0.000 0.334x1.000
      window 4 0.334,0.000 0.334x1.000
      window 3 0.667,0.000 0.333x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating

$ open
workspace splith focus=@
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 2 0.000,0.000 0.250x1.000
      window 5 0.250,0.000 0.250x1.000
      window 4 0.500,0.000 0.250x1.000
      window 3 0.750,0.000 0.250x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating
