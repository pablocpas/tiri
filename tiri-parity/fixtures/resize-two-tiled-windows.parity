# the first thing anyone has asked sway about resize: growing one of two tiled windows
# recorded from sway version 1.11
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ resize grow width 100 px
workspace splith focus=2
  window 1 0.000,0.000 0.422x1.000
  window 2 0.422,0.000 0.578x1.000

$ resize shrink width 100 px
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ resize grow width 200 px
workspace splith focus=2
  window 1 0.000,0.000 0.344x1.000
  window 2 0.344,0.000 0.656x1.000
