# ppt: the unit the command names, read against the nearest parallel ancestor
# recorded from sway version 1.12-dev
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ resize set width 30 ppt
workspace splith focus=2
  window 1 0.000,0.000 0.700x1.000
  window 2 0.700,0.000 0.300x1.000

$ resize grow width 10 ppt
workspace splith focus=2
  window 1 0.000,0.000 0.600x1.000
  window 2 0.600,0.000 0.400x1.000

$ resize set width 75 ppt
workspace splith focus=2
  window 1 0.000,0.000 0.250x1.000
  window 2 0.250,0.000 0.750x1.000
