# Sway 1.12 promotion keeps the moved child's fractions and invalidates the ancestor it
# escaped, so arrange fills both unset top-level branches from the remaining one.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ open
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968

$ layout toggle all
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ split vertical
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    splitv 0.500,0.000 0.500x1.000
      window 2 0.500,0.000 0.500x1.000

$ resize shrink width 200 px
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.656x1.000
    splitv 0.656,0.000 0.344x1.000
      window 2 0.656,0.000 0.344x1.000

$ open
workspace splith focus=3
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.656x1.000
    splitv 0.656,0.000 0.344x1.000
      window 2 0.656,0.000 0.344x0.500
      window 3 0.656,0.500 0.344x0.500

$ move right
workspace splith focus=3
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.334x1.000
    splitv 0.334,0.000 0.334x1.000
      window 2 0.334,0.000 0.334x1.000
    window 3 0.667,0.000 0.333x1.000
