# the edge forms of resize: the direction names which neighbour pays, and only that one
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ focus left
workspace splith focus=2
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ resize grow left 100 px
workspace splith focus=2
  window 1 0.000,0.000 0.255x1.000
  window 2 0.255,0.000 0.412x1.000
  window 3 0.667,0.000 0.333x1.000

$ resize grow right 150 px
workspace splith focus=2
  window 1 0.000,0.000 0.255x1.000
  window 2 0.255,0.000 0.529x1.000
  window 3 0.784,0.000 0.216x1.000

$ resize shrink left 50 px
workspace splith focus=2
  window 1 0.000,0.000 0.295x1.000
  window 2 0.295,0.000 0.490x1.000
  window 3 0.784,0.000 0.216x1.000
