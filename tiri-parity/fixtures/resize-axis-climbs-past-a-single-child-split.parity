# an axis resize climbs past a same-axis split with no sibling to pay
# recorded from sway version 1.11
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ split h
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splith 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ resize grow width 100 px
workspace splith focus=2
  window 1 0.000,0.000 0.422x1.000
  splith 0.422,0.000 0.578x1.000
    window 2 0.422,0.000 0.578x1.000
