# A container entering floating receives its default root box immediately even when another
# fullscreen branch prevents its children from being arranged.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ split v
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ fullscreen toggle
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ splitt
workspace splitv focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ focus parent
workspace splitv focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ split toggle
workspace splitv focus=@0/0
  splith 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ open
workspace splitv focus=@0/0
  splith 0.000,0.000 1.000x1.000
    splith 0.000,0.000 0.500x1.000
      window 1 0.000,0.000 0.500x1.000
    window 3 0.500,0.000 0.500x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ floating toggle
workspace splitv focus=@2
  splith 0.000,0.000 1.000x1.000
    window 3 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden
  splith 0.250,0.125 0.500x0.750
    window 1 0.000,0.000 0.500x1.000 hidden floating
