# Closing a tab restores focus inside the nested tabbed parent before another outer tab.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ move up
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ open
workspace splitv focus=3
  window 1 0.000,0.000 1.000x0.333
  window 2 0.000,0.333 1.000x0.333
  window 3 0.000,0.667 1.000x0.333

$ layout tabbed
workspace splitv focus=3
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968 hidden
    window 3 0.000,0.032 1.000x0.968

$ move up
workspace splitv focus=3
  window 3 0.000,0.000 1.000x0.500
  tabbed 0.000,0.500 1.000x0.500
    window 1 0.000,0.532 1.000x0.468 hidden
    window 2 0.000,0.532 1.000x0.468

$ open
workspace splitv focus=4
  window 3 0.000,0.000 1.000x0.333
  window 4 0.000,0.333 1.000x0.333
  tabbed 0.000,0.667 1.000x0.333
    window 1 0.000,0.699 1.000x0.301 hidden
    window 2 0.000,0.699 1.000x0.301

$ layout tabbed
workspace splitv focus=4
  tabbed 0.000,0.000 1.000x1.000
    window 3 0.000,0.032 1.000x0.968 hidden
    window 4 0.000,0.032 1.000x0.968
    tabbed 0.000,0.064 1.000x0.936
      window 1 0.000,0.064 1.000x0.936 hidden
      window 2 0.000,0.064 1.000x0.936 hidden

$ move right
workspace splitv focus=4
  tabbed 0.000,0.000 1.000x1.000
    window 3 0.000,0.032 1.000x0.968
    tabbed 0.000,0.064 1.000x0.936
      window 4 0.000,0.064 1.000x0.936 hidden
      window 1 0.000,0.064 1.000x0.936 hidden
      window 2 0.000,0.064 1.000x0.936 hidden

$ close
workspace splitv focus=2
  tabbed 0.000,0.000 1.000x1.000
    window 3 0.000,0.032 1.000x0.968 hidden
    tabbed 0.000,0.064 1.000x0.936
      window 1 0.000,0.064 1.000x0.936 hidden
      window 2 0.000,0.064 1.000x0.936
