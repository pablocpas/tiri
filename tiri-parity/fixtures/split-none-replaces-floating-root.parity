# Flattening a single-child floating root preserves the child container as the new root.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ split v
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ focus parent
workspace splith focus=@0/0
  tabbed 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ focus parent
workspace splith focus=@0
  tabbed 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ floating toggle
workspace splith focus=@0
  tabbed 0.250,0.125 0.500x0.750
    splitv 0.250,0.189 0.500x0.686
      window 1 0.250,0.157 0.500x0.718 floating

$ focus child
workspace splith focus=@0/0
  tabbed 0.250,0.125 0.500x0.750
    splitv 0.250,0.189 0.500x0.686
      window 1 0.250,0.157 0.500x0.718 floating

$ split none
workspace splith focus=@0
  splitv 0.250,0.157 0.500x0.718
    window 1 0.250,0.157 0.500x0.718 floating
