# A layout change preserves the fractions produced by an earlier rounded resize.
# recorded from sway version 1.12-dev
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ layout stacking
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.096 1.000x0.904 hidden
    window 2 0.000,0.096 1.000x0.904 hidden
    window 3 0.000,0.096 1.000x0.904

$ open
workspace splith focus=4
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    window 2 0.000,0.128 1.000x0.872 hidden
    window 3 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872

$ focus up
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    window 2 0.000,0.128 1.000x0.872 hidden
    window 3 0.000,0.128 1.000x0.872
    window 4 0.000,0.128 1.000x0.872 hidden

$ move up
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    window 3 0.000,0.128 1.000x0.872
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ split toggle
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    splitv 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.872
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ open
workspace splith focus=5
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    splitv 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.436
      window 5 0.000,0.564 1.000x0.436
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ open
workspace splith focus=6
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    splitv 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.290
      window 5 0.000,0.418 1.000x0.290
      window 6 0.000,0.708 1.000x0.292
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ resize grow height 100 px
workspace splith focus=6
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    splitv 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.221
      window 5 0.000,0.349 1.000x0.221
      window 6 0.000,0.569 1.000x0.431
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ focus parent
workspace splith focus=@0/1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    splitv 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.221
      window 5 0.000,0.349 1.000x0.221
      window 6 0.000,0.569 1.000x0.431
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ move up
workspace splith focus=@0/0
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.221
      window 5 0.000,0.349 1.000x0.221
      window 6 0.000,0.569 1.000x0.431
    window 1 0.000,0.128 1.000x0.872 hidden
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872 hidden

$ layout tabbed
workspace splith focus=@0/0
  tabbed 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 3 0.000,0.032 1.000x0.244
      window 5 0.000,0.276 1.000x0.244
      window 6 0.000,0.521 1.000x0.479
    window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968 hidden
    window 4 0.000,0.032 1.000x0.968 hidden
