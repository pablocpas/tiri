# sway 1.12 divides the cost equally across all siblings, whatever sizes they had
# recorded from sway version 1.12-8886939 (Aug  5 2026, branch 'HEAD')
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ resize grow width 300 px
workspace splith focus=3
  window 1 0.000,0.000 0.216x1.000
  window 2 0.216,0.000 0.216x1.000
  window 3 0.433,0.000 0.567x1.000

$ focus left
workspace splith focus=2
  window 1 0.000,0.000 0.216x1.000
  window 2 0.216,0.000 0.216x1.000
  window 3 0.433,0.000 0.567x1.000

$ resize grow width 100 px
workspace splith focus=2
  window 1 0.000,0.000 0.177x1.000
  window 2 0.177,0.000 0.295x1.000
  window 3 0.472,0.000 0.528x1.000
