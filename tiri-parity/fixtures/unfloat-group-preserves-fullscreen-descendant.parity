# Floating toggle moves the whole group and preserves fullscreen owned by a descendant.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ splitt
workspace splith focus=1
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 floating
    window 2 0.344,0.500 0.312x0.208 floating

$ fullscreen toggle
workspace splith focus=2
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 hidden floating
    window 2 0.000,0.000 1.000x1.000 floating

$ floating toggle
workspace splith focus=2
  splitv 0.344,0.292 1.000x1.000
    window 1 0.344,0.292 0.312x0.208 hidden
    window 2 0.000,0.000 1.000x1.000
