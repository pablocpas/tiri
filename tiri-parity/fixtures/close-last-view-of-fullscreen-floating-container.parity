# Destroying the last view clears the empty container's workspace fullscreen ownership.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ fullscreen toggle
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ floating toggle
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  window 1 0.000,0.000 1.000x1.000 floating

$ split h
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000 floating

$ close
workspace splith focus=2
  window 2 0.000,0.000 1.000x1.000
