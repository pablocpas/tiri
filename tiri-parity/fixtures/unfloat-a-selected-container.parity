# floating a container the user asked for and putting it back is a round trip; the container
# is not a wrapper tiri may unwrap on the way in.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout toggle all
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@0
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=@0
  splitv 0.250,0.125 0.500x0.750
    window 1 0.250,0.125 0.500x0.750 floating

$ floating toggle
workspace splith focus=@0
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
