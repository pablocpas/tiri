# A vertical split does not promote the full focused ancestry through an outer stack.
# recorded from sway version 1.12-dev
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split h
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splith 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splith 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.250x1.000
    window 3 0.750,0.000 0.250x1.000

$ focus left
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splith 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.250x1.000
    window 3 0.750,0.000 0.250x1.000

$ move left
workspace splith focus=2
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  splith 0.667,0.000 0.333x1.000
    window 3 0.667,0.000 0.333x1.000

$ open
workspace splith focus=4
  window 1 0.000,0.000 0.250x1.000
  window 2 0.250,0.000 0.250x1.000
  window 4 0.500,0.000 0.250x1.000
  splith 0.750,0.000 0.250x1.000
    window 3 0.750,0.000 0.250x1.000

$ layout stacking
workspace splith focus=4
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.128 1.000x0.872 hidden
    window 2 0.000,0.128 1.000x0.872 hidden
    window 4 0.000,0.128 1.000x0.872
    splith 0.000,0.256 1.000x0.744
      window 3 0.000,0.128 1.000x0.872 hidden

$ move down
workspace splith focus=4
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.096 1.000x0.904 hidden
    window 2 0.000,0.096 1.000x0.904
    splith 0.000,0.192 1.000x0.808
      window 4 0.000,0.096 0.500x0.904 hidden
      window 3 0.500,0.096 0.500x0.904 hidden

$ split v
workspace splith focus=4
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.096 1.000x0.904 hidden
    window 2 0.000,0.096 1.000x0.904
    splith 0.000,0.192 1.000x0.808
      splitv 0.000,0.096 0.500x0.904
        window 4 0.000,0.096 0.500x0.904 hidden
      window 3 0.500,0.096 0.500x0.904 hidden
