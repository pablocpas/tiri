# Opening inside a floating split with fullscreen arranges that group directly instead of
# stopping at the workspace-fullscreen branch.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating

$ splitv
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000
  splitv 0.344,0.292 0.312x0.417
    window 2 0.344,0.292 0.312x0.417 floating

$ fullscreen toggle
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000 hidden
  splitv 0.344,0.292 0.312x0.417
    window 2 0.000,0.000 1.000x1.000 floating

$ open
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000 hidden
  splitv 0.344,0.292 0.312x0.417
    window 2 0.344,0.292 0.312x0.208 floating
    window 3 0.344,0.500 0.312x0.208 hidden floating
