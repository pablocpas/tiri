# A squash destroying the very container `focus parent` had selected.
# 
# Written from a missed mutant, not from a fuzz find: flipping the equality that redirects
# the selection in `splice_squashed_pair` changed nothing any recording could see. The
# search reaches container selection often and squashes often, and almost never both at
# once on the same node.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.500
    window 3 0.500,0.500 0.500x0.500

$ move up
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 3 0.500,0.000 0.500x0.500
    window 2 0.500,0.500 0.500x0.500

$ focus parent
workspace splith focus=@1
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 3 0.500,0.000 0.500x0.500
    window 2 0.500,0.500 0.500x0.500

$ move left
workspace splith focus=@0
  splitv 0.000,0.000 0.500x1.000
    window 3 0.000,0.000 0.500x0.500
    window 2 0.000,0.500 0.500x0.500
  window 1 0.500,0.000 0.500x1.000
