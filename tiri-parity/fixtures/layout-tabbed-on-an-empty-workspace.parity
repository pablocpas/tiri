# layout tabbed on an empty workspace: the workspace becomes tabbed, no container is built
# recorded from sway version 1.11
# client 400x285

$ layout tabbed
workspace tabbed focus=@

$ open
workspace tabbed focus=1
  window 1 0.000,0.037 1.000x0.963

$ open
workspace tabbed focus=2
  window 1 0.000,0.037 1.000x0.963 hidden
  window 2 0.000,0.037 1.000x0.963
