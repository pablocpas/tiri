# the same rule reached the other way: the window that lands the focus was opened hidden
# behind the fullscreen and had never held it.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 1.000x1.000

$ split t
workspace splitv focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ fullscreen toggle
workspace splitv focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ close
workspace splitv focus=2
  window 2 0.000,0.000 1.000x1.000
