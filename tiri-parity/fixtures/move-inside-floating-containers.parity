# Directional moves can reorder siblings and cross nested containers inside one floating root.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ split v
workspace splith focus=1
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 floating
    window 2 0.344,0.500 0.312x0.208 floating

$ split h
workspace splith focus=2
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 floating
    splith 0.344,0.500 0.312x0.208
      window 2 0.344,0.500 0.312x0.208 floating

$ open
workspace splith focus=3
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 floating
    splith 0.344,0.500 0.312x0.208
      window 2 0.344,0.500 0.156x0.208 floating
      window 3 0.500,0.500 0.156x0.208 floating

$ move left
workspace splith focus=3
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 floating
    splith 0.344,0.500 0.312x0.208
      window 3 0.344,0.500 0.156x0.208 floating
      window 2 0.500,0.500 0.156x0.208 floating

$ move up
workspace splith focus=3
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.139 floating
    window 3 0.344,0.431 0.312x0.139 floating
    splith 0.344,0.569 0.312x0.139
      window 2 0.344,0.569 0.312x0.139 floating
