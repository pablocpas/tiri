# A second route to sway invalidating the ancestor's fraction instead of the moved node's
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ split v
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ move left
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ move down
workspace splitv focus=2
  splith 0.000,0.000 1.000x0.500
    window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ open
workspace splitv focus=3
  splith 0.000,0.000 1.000x0.333
    window 1 0.000,0.000 1.000x0.333
  window 2 0.000,0.333 1.000x0.333
  window 3 0.000,0.667 1.000x0.333

$ move right
workspace splith focus=3
  splitv 0.000,0.000 0.500x1.000
    splith 0.000,0.000 0.500x0.500
      window 1 0.000,0.000 0.500x0.500
    window 2 0.000,0.500 0.500x0.500
  window 3 0.500,0.000 0.500x1.000

$ focus right
workspace splith focus=2
  splitv 0.000,0.000 0.500x1.000
    splith 0.000,0.000 0.500x0.500
      window 1 0.000,0.000 0.500x0.500
    window 2 0.000,0.500 0.500x0.500
  window 3 0.500,0.000 0.500x1.000

$ move left
workspace splith focus=2
  window 2 0.000,0.000 0.334x1.000
  window 1 0.334,0.000 0.445x1.000
  window 3 0.778,0.000 0.222x1.000
