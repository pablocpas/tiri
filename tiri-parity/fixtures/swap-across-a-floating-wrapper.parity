# Swapping children across tiled and floating parents leaves both parent slots in place.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ layout toggle split
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ swap container with 1
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating
