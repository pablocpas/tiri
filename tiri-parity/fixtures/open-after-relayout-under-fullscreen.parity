# A new sibling under a relaid-out fullscreen branch must join that branch's geometry.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ move up
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ focus child
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ fullscreen toggle
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500 hidden
  window 2 0.000,0.000 1.000x1.000

$ split v
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500 hidden
  splitv 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000

$ layout splith
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500 hidden
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500 hidden
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 0.500x1.000
    window 3 0.500,0.000 0.500x1.000
