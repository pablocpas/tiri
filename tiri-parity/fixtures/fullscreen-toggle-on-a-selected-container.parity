# Fullscreen follows the selected container, not its inactive-focus representative.
# recorded from sway version 1.11
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ layout toggle all
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  stacked 0.500,0.000 0.500x1.000
    window 2 0.500,0.032 0.500x0.968

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  stacked 0.500,0.000 0.500x1.000
    splitv 0.500,0.064 0.500x0.936
      window 2 0.500,0.032 0.500x0.968

$ move right
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split v
workspace splitv focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ layout splith
workspace splitv focus=@0/0
  splith 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 0.500x1.000
      window 2 0.500,0.000 0.500x1.000

$ fullscreen toggle
workspace splitv focus=@0/0
  splith 0.000,0.000 1.000x1.000
    splith 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 0.500x1.000
      window 2 0.500,0.000 0.500x1.000
