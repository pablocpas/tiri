# Floating the selected workspace creates a selected container that can own fullscreen.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ floating toggle
workspace splith focus=@0
  splith 0.250,0.125 0.500x0.750
    window 1 0.250,0.125 0.250x0.750 floating
    window 2 0.500,0.125 0.250x0.750 floating

$ fullscreen toggle
workspace splith focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000 floating
    window 2 0.500,0.000 0.500x1.000 floating

$ fullscreen toggle
workspace splith focus=@0
  splith 0.250,0.125 0.500x0.750
    window 1 0.250,0.125 0.250x0.750 floating
    window 2 0.500,0.125 0.250x0.750 floating
