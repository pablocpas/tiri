# Closing inside a nested split prefers the surviving sibling in that split.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ open
workspace splith focus=4
  window 1 0.000,0.000 0.250x1.000
  window 2 0.250,0.000 0.250x1.000
  window 3 0.500,0.000 0.250x1.000
  window 4 0.750,0.000 0.250x1.000

$ layout toggle split
workspace splith focus=4
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.250
    window 2 0.000,0.250 1.000x0.250
    window 3 0.000,0.500 1.000x0.250
    window 4 0.000,0.750 1.000x0.250

$ move right
workspace splith focus=4
  splitv 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x0.333
    window 2 0.000,0.333 0.500x0.333
    window 3 0.000,0.667 0.500x0.333
  window 4 0.500,0.000 0.500x1.000

$ focus right
workspace splith focus=3
  splitv 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x0.333
    window 2 0.000,0.333 0.500x0.333
    window 3 0.000,0.667 0.500x0.333
  window 4 0.500,0.000 0.500x1.000

$ focus prev
workspace splith focus=2
  splitv 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x0.333
    window 2 0.000,0.333 0.500x0.333
    window 3 0.000,0.667 0.500x0.333
  window 4 0.500,0.000 0.500x1.000

$ focus prev
workspace splith focus=1
  splitv 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x0.333
    window 2 0.000,0.333 0.500x0.333
    window 3 0.000,0.667 0.500x0.333
  window 4 0.500,0.000 0.500x1.000

$ move right
workspace splith focus=1
  splitv 0.000,0.000 0.334x1.000
    window 2 0.000,0.000 0.334x0.500
    window 3 0.000,0.500 0.334x0.500
  window 1 0.334,0.000 0.334x1.000
  window 4 0.667,0.000 0.333x1.000

$ layout splitv
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x0.333
      window 2 0.000,0.000 1.000x0.167
      window 3 0.000,0.167 1.000x0.167
    window 1 0.000,0.333 1.000x0.333
    window 4 0.000,0.667 1.000x0.333

$ focus up
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x0.333
      window 2 0.000,0.000 1.000x0.167
      window 3 0.000,0.167 1.000x0.167
    window 1 0.000,0.333 1.000x0.333
    window 4 0.000,0.667 1.000x0.333

$ close
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x0.333
      window 3 0.000,0.000 1.000x0.333
    window 1 0.000,0.333 1.000x0.333
    window 4 0.000,0.667 1.000x0.333
