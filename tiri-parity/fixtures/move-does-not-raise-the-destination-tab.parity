# `move` focuses the window it moved and leaves the destination showing something else.
# 
# sway's `cmd_move` moves the node and never touches the seat, so a tabbed or stacked
# destination goes on showing whatever tab it was showing. The window sway reports as focused
# is one the user cannot see, and it stays that way until the next `focus` command of any
# kind heals it.
# 
# Found independently by three fuzz seeds (0x7, 0x8, 0x9) in the deep tree-only space, always
# the same shape and never the same script.
# recorded from sway version 1.12-dev
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ move left
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ open
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968

$ open
workspace splith focus=3
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968 hidden
    window 3 0.000,0.032 1.000x0.968

$ move up
workspace splitv focus=3
  window 3 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    tabbed 0.000,0.500 1.000x0.500
      window 1 0.000,0.532 1.000x0.468 hidden
      window 2 0.000,0.532 1.000x0.468

$ layout toggle all
workspace splitv focus=3
  stacked 0.000,0.000 1.000x1.000
    window 3 0.000,0.064 1.000x0.936
    splith 0.000,0.128 1.000x0.872
      tabbed 0.000,0.064 1.000x0.936
        window 1 0.000,0.096 1.000x0.904 hidden
        window 2 0.000,0.096 1.000x0.904 hidden

$ move down
workspace splitv focus=3
  stacked 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      tabbed 0.000,0.032 1.000x0.968
        window 1 0.000,0.064 1.000x0.936 hidden
        window 3 0.000,0.064 1.000x0.936
        window 2 0.000,0.064 1.000x0.936 hidden
