# Changing the outer layout does not redistribute the inner split's accumulated pixels.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout splitv
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ move right
workspace splith focus=2
  splitv 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  splitv 0.000,0.000 0.334x1.000
    window 1 0.000,0.000 0.334x1.000
  window 2 0.334,0.000 0.334x1.000
  window 3 0.667,0.000 0.333x1.000

$ open
workspace splith focus=4
  splitv 0.000,0.000 0.250x1.000
    window 1 0.000,0.000 0.250x1.000
  window 2 0.250,0.000 0.250x1.000
  window 3 0.500,0.000 0.250x1.000
  window 4 0.750,0.000 0.250x1.000

$ move up
workspace splitv focus=4
  window 4 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    splitv 0.000,0.500 0.334x0.500
      window 1 0.000,0.500 0.334x0.500
    window 2 0.334,0.500 0.334x0.500
    window 3 0.667,0.500 0.333x0.500

$ move right
workspace splith focus=4
  window 3 0.000,0.000 0.250x1.000
  window 2 0.250,0.000 0.250x1.000
  splitv 0.500,0.000 0.250x1.000
    window 1 0.500,0.000 0.250x1.000
  window 4 0.750,0.000 0.250x1.000

$ move up
workspace splitv focus=4
  window 4 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 3 0.000,0.500 0.334x0.500
    window 2 0.334,0.500 0.334x0.500
    splitv 0.667,0.500 0.333x0.500
      window 1 0.667,0.500 0.333x0.500

$ move down
workspace splitv focus=4
  splith 0.000,0.000 1.000x1.000
    window 4 0.000,0.000 0.250x1.000
    window 3 0.250,0.000 0.250x1.000
    window 2 0.500,0.000 0.250x1.000
    splitv 0.750,0.000 0.250x1.000
      window 1 0.750,0.000 0.250x1.000

$ layout splitv
workspace splitv focus=4
  splitv 0.000,0.000 1.000x1.000
    window 4 0.000,0.000 1.000x0.250
    window 3 0.000,0.250 1.000x0.250
    window 2 0.000,0.500 1.000x0.250
    splitv 0.000,0.750 1.000x0.250
      window 1 0.000,0.750 1.000x0.250

$ layout tabbed
workspace splitv focus=4
  tabbed 0.000,0.000 1.000x1.000
    window 4 0.000,0.032 1.000x0.968
    window 3 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden

