# Re-enabling floating recalculates a view's natural size instead of restoring a prior resize.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout splith
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating

$ resize grow height 400 px
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.014 0.312x0.972 floating

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating
