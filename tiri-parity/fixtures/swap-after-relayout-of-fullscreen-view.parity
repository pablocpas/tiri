# Swapping after changing layout around a fullscreen view preserves sway's exact focus target.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout toggle split
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ focus next
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ focus next sibling
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ focus down
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ focus prev
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ fullscreen toggle
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500 hidden
    window 2 0.000,0.000 1.000x1.000

$ layout splith
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500 hidden
    window 2 0.000,0.000 1.000x1.000

$ swap container with 1
workspace splith focus=1
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 0.500x1.000 hidden
    window 1 0.500,0.000 0.500x1.000
