# Verify where Sway applies `layout toggle` after a whole-workspace floating round-trip.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ layout splitv
workspace splitv focus=@
  window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ layout tabbed
workspace tabbed focus=@
  window 1 0.000,0.032 1.000x0.968 hidden
  window 2 0.000,0.032 1.000x0.968

$ floating toggle
workspace splith focus=@0
  tabbed 0.250,0.125 0.500x0.750
    window 1 0.250,0.157 0.500x0.718 hidden floating
    window 2 0.250,0.157 0.500x0.718 floating

$ floating toggle
workspace splith focus=@0
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968

$ layout toggle
workspace splith focus=@0/0
  splitv 0.000,0.000 1.000x1.000
    tabbed 0.000,0.000 1.000x1.000
      window 1 0.000,0.032 1.000x0.968 hidden
      window 2 0.000,0.032 1.000x0.968
