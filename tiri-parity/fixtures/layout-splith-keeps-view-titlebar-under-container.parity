# A layout change keeps a lone view's title bar when the view remains under a container.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ split horizontal
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ open
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 0.500x0.968
      window 2 0.500,0.032 0.500x0.968

$ move up
workspace splitv focus=2
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    tabbed 0.000,0.500 1.000x0.500
      splith 0.000,0.564 1.000x0.436
        window 1 0.000,0.532 1.000x0.468

$ focus down
workspace splitv focus=1
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    tabbed 0.000,0.500 1.000x0.500
      splith 0.000,0.564 1.000x0.436
        window 1 0.000,0.532 1.000x0.468

$ layout tabbed
workspace splitv focus=1
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    tabbed 0.000,0.500 1.000x0.500
      window 1 0.000,0.564 1.000x0.436

$ layout splith
workspace splitv focus=1
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 1 0.000,0.532 1.000x0.468
