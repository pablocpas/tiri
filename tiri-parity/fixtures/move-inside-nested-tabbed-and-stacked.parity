# move inside nested tabbed and stacked containers
# recorded from sway version 1.12-8886939 (Aug  5 2026, branch 'HEAD')
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout stacking
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ split v
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ open
workspace splith focus=2
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.485
      window 2 0.000,0.517 1.000x0.483

$ open
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.322
      window 2 0.000,0.354 1.000x0.322
      window 3 0.000,0.676 1.000x0.324

$ layout tabbed
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    tabbed 0.000,0.064 1.000x0.936
      window 1 0.000,0.064 1.000x0.936 hidden
      window 2 0.000,0.064 1.000x0.936 hidden
      window 3 0.000,0.064 1.000x0.936

$ split h
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    tabbed 0.000,0.064 1.000x0.936
      window 1 0.000,0.064 1.000x0.936 hidden
      window 2 0.000,0.064 1.000x0.936 hidden
      splith 0.000,0.096 1.000x0.904
        window 3 0.000,0.064 1.000x0.936

$ move right
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    tabbed 0.000,0.064 1.000x0.936
      window 1 0.000,0.064 1.000x0.936 hidden
      window 2 0.000,0.064 1.000x0.936 hidden
      window 3 0.000,0.064 1.000x0.936
