# move inside nested tabbed and stacked containers
# recorded from sway version 1.11

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout stacking
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.037 1.000x0.963

$ split v
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.075 1.000x0.925
      window 1 0.000,0.037 1.000x0.963

$ open
workspace splith focus=2
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.075 1.000x0.925
      window 1 0.000,0.037 1.000x0.482
      window 2 0.000,0.519 1.000x0.481

$ open
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.075 1.000x0.925
      window 1 0.000,0.037 1.000x0.321
      window 2 0.000,0.358 1.000x0.321
      window 3 0.000,0.679 1.000x0.321

$ layout tabbed
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    tabbed 0.000,0.075 1.000x0.925
      window 1 0.000,0.075 1.000x0.925 hidden
      window 2 0.000,0.075 1.000x0.925 hidden
      window 3 0.000,0.075 1.000x0.925

$ split h
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    tabbed 0.000,0.075 1.000x0.925
      window 1 0.000,0.075 1.000x0.925 hidden
      window 2 0.000,0.075 1.000x0.925 hidden
      splith 0.000,0.113 1.000x0.887
        window 3 0.000,0.075 1.000x0.925

$ move right
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    tabbed 0.000,0.075 1.000x0.925
      window 1 0.000,0.075 1.000x0.925 hidden
      window 2 0.000,0.075 1.000x0.925 hidden
      window 3 0.000,0.075 1.000x0.925
