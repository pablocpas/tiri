# resize set, which is the adjust path with the delta worked out first
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ resize set width 400 px
workspace splith focus=2
  window 1 0.000,0.000 0.688x1.000
  window 2 0.688,0.000 0.312x1.000

$ resize set width 900 px
workspace splith focus=2
  window 1 0.000,0.000 0.297x1.000
  window 2 0.297,0.000 0.703x1.000
