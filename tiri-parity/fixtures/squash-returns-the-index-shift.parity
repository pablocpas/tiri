# `container_squash` returns how many children it added where one used to be, and
# `container_squash_children` steps its loop by that. Get the count wrong and the walk skips
# a sibling — invisible unless a later command lands on the one it skipped.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.500
    window 3 0.500,0.500 0.500x0.500

$ split h
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.500
    splith 0.500,0.500 0.500x0.500
      window 3 0.500,0.500 0.500x0.500

$ open
workspace splith focus=4
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.500
    splith 0.500,0.500 0.500x0.500
      window 3 0.500,0.500 0.250x0.500
      window 4 0.750,0.500 0.250x0.500

$ move up
workspace splith focus=4
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.333
    window 4 0.500,0.333 0.500x0.333
    splith 0.500,0.667 0.500x0.333
      window 3 0.500,0.667 0.500x0.333

$ move left
workspace splith focus=4
  window 1 0.000,0.000 0.334x1.000
  window 4 0.334,0.000 0.334x1.000
  splitv 0.667,0.000 0.333x1.000
    window 2 0.667,0.000 0.333x0.500
    splith 0.667,0.500 0.333x0.500
      window 3 0.667,0.500 0.333x0.500

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.334x1.000
  window 4 0.334,0.000 0.334x1.000
  splitv 0.667,0.000 0.333x1.000
    window 2 0.667,0.000 0.333x0.500
    splith 0.667,0.500 0.333x0.500
      window 3 0.667,0.500 0.333x0.500

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.334x1.000
  window 4 0.334,0.000 0.334x1.000
  splitv 0.667,0.000 0.333x1.000
    window 2 0.667,0.000 0.333x0.500
    splith 0.667,0.500 0.333x0.500
      window 3 0.667,0.500 0.333x0.500

$ layout tabbed
workspace tabbed focus=@
  window 1 0.000,0.032 1.000x0.968 hidden
  window 4 0.000,0.032 1.000x0.968
  splitv 0.000,0.064 1.000x0.936
