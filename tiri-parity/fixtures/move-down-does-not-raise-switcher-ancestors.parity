# A move keeps seat focus without raising every switcher ancestor of the moved view.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ layout toggle split
workspace splith focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ layout stacking
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968

$ layout toggle split
workspace splith focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ split v
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    splitv 0.500,0.000 0.500x1.000
      window 2 0.500,0.000 0.500x1.000

$ focus left
workspace splith focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    splitv 0.500,0.000 0.500x1.000
      window 2 0.500,0.000 0.500x1.000

$ layout stacking
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.064 1.000x0.936
    splitv 0.000,0.128 1.000x0.872
      window 2 0.000,0.064 1.000x0.936 hidden

$ open
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.096 1.000x0.904 hidden
    window 3 0.000,0.096 1.000x0.904
    splitv 0.000,0.192 1.000x0.808
      window 2 0.000,0.096 1.000x0.904 hidden

$ move down
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.064 1.000x0.936
    splitv 0.000,0.128 1.000x0.872
      window 3 0.000,0.064 1.000x0.468 hidden
      window 2 0.000,0.532 1.000x0.468 hidden

$ move down
workspace splith focus=3
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.064 1.000x0.936
    splitv 0.000,0.128 1.000x0.872
      window 2 0.000,0.064 1.000x0.468 hidden
      window 3 0.000,0.532 1.000x0.468 hidden
