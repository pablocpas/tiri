# a directional focus off a selected container still wraps, and a wrap always descends to a
# view: nothing about the selection suppresses either.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ splith
workspace splith focus=1
  splith 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  splith 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.156x0.417 floating
    window 2 0.500,0.292 0.156x0.417 floating

$ split vertical
workspace splith focus=2
  splith 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.156x0.417 floating
    splitv 0.500,0.292 0.156x0.417
      window 2 0.500,0.292 0.156x0.417 floating

$ focus right
workspace splith focus=1
  splith 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.156x0.417 floating
    splitv 0.500,0.292 0.156x0.417
      window 2 0.500,0.292 0.156x0.417 floating

$ layout toggle
workspace splith focus=1
  splitv 0.344,0.292 0.312x0.417
    window 1 0.344,0.292 0.312x0.208 floating
    splitv 0.344,0.500 0.312x0.208
      window 2 0.344,0.500 0.312x0.208 floating

$ split h
workspace splith focus=1
  splitv 0.344,0.292 0.312x0.417
    splith 0.344,0.292 0.312x0.208
      window 1 0.344,0.292 0.312x0.208 floating
    splitv 0.344,0.500 0.312x0.208
      window 2 0.344,0.500 0.312x0.208 floating

$ focus parent
workspace splith focus=@0/0
  splitv 0.344,0.292 0.312x0.417
    splith 0.344,0.292 0.312x0.208
      window 1 0.344,0.292 0.312x0.208 floating
    splitv 0.344,0.500 0.312x0.208
      window 2 0.344,0.500 0.312x0.208 floating

$ move down
workspace splith focus=@0/0/0
  splitv 0.344,0.292 0.312x0.417
    splitv 0.344,0.292 0.312x0.417
      splith 0.344,0.292 0.312x0.208
        window 1 0.344,0.292 0.312x0.208 floating
      window 2 0.344,0.500 0.312x0.208 floating

$ layout toggle split
workspace splith focus=@0/0/0
  splitv 0.344,0.292 0.312x0.417
    splith 0.344,0.292 0.312x0.417
      splith 0.344,0.292 0.156x0.417
        window 1 0.344,0.292 0.156x0.417 floating
      window 2 0.500,0.292 0.156x0.417 floating

$ focus left
workspace splith focus=2
  splitv 0.344,0.292 0.312x0.417
    splith 0.344,0.292 0.312x0.417
      splith 0.344,0.292 0.156x0.417
        window 1 0.344,0.292 0.156x0.417 floating
      window 2 0.500,0.292 0.156x0.417 floating
