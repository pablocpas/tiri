# the same, where the parent is stacked so next means down
# recorded from sway version 1.11
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ layout stacking
workspace splith focus=2
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.075 1.000x0.925 hidden
    window 2 0.000,0.075 1.000x0.925

$ focus prev
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.075 1.000x0.925
    window 2 0.000,0.075 1.000x0.925 hidden

$ focus next
workspace splith focus=2
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.075 1.000x0.925 hidden
    window 2 0.000,0.075 1.000x0.925
