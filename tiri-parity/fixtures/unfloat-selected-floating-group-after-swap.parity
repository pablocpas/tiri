# Floating the selected one-window container keeps its explicit root and selection, even with
# another floating root already present.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=3
  window 2 0.000,0.000 0.500x1.000
  window 3 0.500,0.000 0.500x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ move up
workspace splitv focus=3
  window 3 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 2 0.000,0.500 1.000x0.500
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splitv focus=4
  window 3 0.000,0.000 1.000x0.333
  window 4 0.000,0.333 1.000x0.333
  splith 0.000,0.667 1.000x0.333
    window 2 0.000,0.667 1.000x0.333
  window 1 0.344,0.292 0.312x0.417 floating

$ close
workspace splitv focus=3
  window 3 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 2 0.000,0.500 1.000x0.500
  window 1 0.344,0.292 0.312x0.417 floating

$ swap container with 2
workspace splitv focus=3
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 3 0.000,0.500 1.000x0.500
  window 1 0.344,0.292 0.312x0.417 floating

$ focus parent
workspace splitv focus=@1
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 3 0.000,0.500 1.000x0.500
  window 1 0.344,0.292 0.312x0.417 floating

$ move left
workspace splith focus=@0
  splith 0.000,0.000 0.500x1.000
    window 3 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ focus prev sibling
workspace splith focus=2
  splith 0.000,0.000 0.500x1.000
    window 3 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ focus parent
workspace splith focus=@1
  splith 0.000,0.000 0.500x1.000
    window 3 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ floating toggle
workspace splith focus=@2
  splith 0.000,0.000 1.000x1.000
    window 3 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating
  splitv 0.250,0.125 0.500x0.750
    window 2 0.250,0.125 0.500x0.750 floating
