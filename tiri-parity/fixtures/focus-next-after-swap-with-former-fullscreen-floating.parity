# `focus next` follows Sway's focus order after a fullscreen view is floated and a container is
# swapped across the tiled branch.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ focus right
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ fullscreen toggle
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  window 2 0.000,0.000 1.000x1.000

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  splitv 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  splitv 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x0.500
    window 3 0.000,0.500 1.000x0.500

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  splitv 0.000,0.000 1.000x1.000
    window 3 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 hidden floating

$ swap container with 1
workspace splith focus=2
  window 2 0.000,0.000 0.500x1.000 hidden
  splitv 0.000,0.000 1.000x1.000
    window 3 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating

$ focus next
workspace splith focus=3
  window 2 0.000,0.000 0.500x1.000 hidden
  splitv 0.000,0.000 1.000x1.000
    window 3 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 hidden floating
