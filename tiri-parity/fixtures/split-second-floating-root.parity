# IPC order and root provenance are independent: splitting the top group must not annotate the
# older group merely because IPC publishes the stack in reverse.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ floating toggle
workspace splith focus=2
  window 1 0.344,0.292 0.312x0.417 floating
  window 2 0.344,0.292 0.312x0.417 floating

$ split horizontal
workspace splith focus=2
  window 1 0.344,0.292 0.312x0.417 floating
  splith 0.344,0.292 0.312x0.417
    window 2 0.344,0.292 0.312x0.417 floating
