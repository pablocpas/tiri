# the walk climbs to the floating root and finds it fullscreen, which sends it looking for
# another output rather than wrapping between the tabs underneath.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ fullscreen toggle
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000 floating

$ open
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  window 1 0.000,0.000 1.000x1.000 floating

$ split horizontal
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000 floating

$ layout stacking
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 floating

$ open
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.064 1.000x0.936 floating
    window 3 0.000,0.064 1.000x0.936 hidden floating

$ focus up
workspace splith focus=1
  window 2 0.000,0.000 0.000x0.000 hidden
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.064 1.000x0.936 floating
    window 3 0.000,0.064 1.000x0.936 hidden floating
