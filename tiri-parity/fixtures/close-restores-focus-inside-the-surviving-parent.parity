# Closing the focused node restores the most recent view inside its surviving parent before
# considering the rest of the workspace.
# recorded from sway version 1.12-dev
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split h
workspace splith focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  splith 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.250x1.000
    window 2 0.250,0.000 0.250x1.000
  window 3 0.500,0.000 0.500x1.000

$ focus prev
workspace splith focus=2
  splith 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.250x1.000
    window 2 0.250,0.000 0.250x1.000
  window 3 0.500,0.000 0.500x1.000

$ close
workspace splith focus=1
  splith 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x1.000
  window 3 0.500,0.000 0.500x1.000
