# Growing a fullscreen floating container at the output boundary is a no-op.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ fullscreen toggle
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  window 2 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  window 2 0.000,0.000 1.000x1.000 floating

$ split horizontal
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000 floating

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000 hidden
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 0.500x1.000 floating
    window 3 0.500,0.000 0.500x1.000 floating

$ focus parent
workspace splith focus=@1
  window 1 0.000,0.000 0.500x1.000 hidden
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 0.500x1.000 floating
    window 3 0.500,0.000 0.500x1.000 floating

$ resize grow down 150 px
workspace splith focus=@1
  window 1 0.000,0.000 0.500x1.000 hidden
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 0.500x1.000 floating
    window 3 0.500,0.000 0.500x1.000 floating
