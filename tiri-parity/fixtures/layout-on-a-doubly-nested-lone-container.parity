# layout on a container that is alone inside a container that is alone
# 
# sway 1.12-dev flattens exactly one level here ("flatten once, like i3", cmd_layout), while
# 1.11 retyped the inner container and left both levels. This recording pins the 1.12 rule.
# recorded from sway version 1.12-8886939 (Aug  5 2026, branch 'HEAD')
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 1.000x1.000

$ split h
workspace splith focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ focus child
workspace splith focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace splith focus=@0/0
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ focus child
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ layout splitv
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
