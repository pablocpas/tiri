# container_split raw-focuses only its wrapper and child, leaving outer switchers unchanged.
# recorded from sway version 1.12-dev
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ split v
workspace splitv focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=2
  window 1 0.000,0.000 1.000x0.500
  window 2 0.000,0.500 1.000x0.500

$ move left
workspace splith focus=2
  window 2 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 1 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 2 0.000,0.000 0.334x1.000
  window 3 0.334,0.000 0.334x1.000
  splitv 0.667,0.000 0.333x1.000
    window 1 0.667,0.000 0.333x1.000

$ layout tabbed
workspace splith focus=3
  tabbed 0.000,0.000 1.000x1.000
    window 2 0.000,0.032 1.000x0.968 hidden
    window 3 0.000,0.032 1.000x0.968
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden

$ split h
workspace splith focus=3
  tabbed 0.000,0.000 1.000x1.000
    window 2 0.000,0.032 1.000x0.968 hidden
    splith 0.000,0.064 1.000x0.936
      window 3 0.000,0.032 1.000x0.968
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden

$ focus next
workspace splith focus=1
  tabbed 0.000,0.000 1.000x1.000
    window 2 0.000,0.032 1.000x0.968 hidden
    splith 0.000,0.064 1.000x0.936
      window 3 0.000,0.032 1.000x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ open
workspace splith focus=4
  tabbed 0.000,0.000 1.000x1.000
    window 2 0.000,0.032 1.000x0.968 hidden
    splith 0.000,0.064 1.000x0.936
      window 3 0.000,0.032 1.000x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.485
      window 4 0.000,0.517 1.000x0.483

$ move left
workspace splith focus=4
  tabbed 0.000,0.000 1.000x1.000
    window 2 0.000,0.032 1.000x0.968 hidden
    splith 0.000,0.064 1.000x0.936
      window 3 0.000,0.032 0.500x0.968 hidden
      window 4 0.500,0.032 0.500x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968

$ split horizontal
workspace splith focus=4
  tabbed 0.000,0.000 1.000x1.000
    window 2 0.000,0.032 1.000x0.968 hidden
    splith 0.000,0.064 1.000x0.936
      window 3 0.000,0.032 0.500x0.968 hidden
      splith 0.500,0.032 0.500x0.968
        window 4 0.500,0.032 0.500x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968
