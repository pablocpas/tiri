# Changing a nested fullscreen layout preserves boxes that Sway does not arrange.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 1.000x1.000

$ split h
workspace splith focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splith 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ layout tabbed
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.032 1.000x0.968

$ fullscreen toggle
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.000 1.000x1.000
    window 3 0.000,0.032 1.000x0.968 hidden

$ open
workspace splith focus=2
  tabbed 0.000,0.000 1.000x1.000
    splith 0.000,0.064 1.000x0.936
      window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.000 1.000x1.000
    window 4 0.000,0.032 1.000x0.968 hidden
    window 3 0.000,0.032 1.000x0.968 hidden

$ layout splith
workspace splith focus=2
  splith 0.000,0.000 1.000x1.000
    splith 0.000,0.032 1.000x0.968
      window 1 0.000,0.032 1.000x0.968 hidden
    window 2 0.000,0.000 1.000x1.000
    window 4 0.000,0.000 1.000x1.000 hidden
    window 3 0.000,0.000 1.000x1.000 hidden
