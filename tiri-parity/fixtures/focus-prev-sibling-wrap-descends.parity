# `sibling` suppresses descent for a direct step, but Sway's edge wrap still descends
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ layout stacking
workspace splith focus=2
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.064 1.000x0.936 hidden
    window 2 0.000,0.064 1.000x0.936

$ move left
workspace splith focus=2
  window 2 0.000,0.000 0.500x1.000
  stacked 0.500,0.000 0.500x1.000
    window 1 0.500,0.032 0.500x0.968

$ split h
workspace splith focus=2
  splith 0.000,0.000 0.500x1.000
    window 2 0.000,0.000 0.500x1.000
  stacked 0.500,0.000 0.500x1.000
    window 1 0.500,0.032 0.500x0.968

$ focus parent
workspace splith focus=@0
  splith 0.000,0.000 0.500x1.000
    window 2 0.000,0.000 0.500x1.000
  stacked 0.500,0.000 0.500x1.000
    window 1 0.500,0.032 0.500x0.968

$ focus prev sibling
workspace splith focus=1
  splith 0.000,0.000 0.500x1.000
    window 2 0.000,0.000 0.500x1.000
  stacked 0.500,0.000 0.500x1.000
    window 1 0.500,0.032 0.500x0.968
