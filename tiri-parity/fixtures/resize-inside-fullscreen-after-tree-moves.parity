# Resize inside fullscreen after nested moves keeps Sway's pending ancestor geometry.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ move right
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split vertical
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ open
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.500
    window 3 0.500,0.500 0.500x0.500

$ open
workspace splith focus=4
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.333
    window 3 0.500,0.333 0.500x0.333
    window 4 0.500,0.667 0.500x0.333

$ close
workspace splith focus=3
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x0.500
    window 3 0.500,0.500 0.500x0.500

$ move down
workspace splitv focus=3
  splith 0.000,0.000 1.000x0.500
    window 1 0.000,0.000 0.500x0.500
    splitv 0.500,0.000 0.500x0.500
      window 2 0.500,0.000 0.500x0.500
  window 3 0.000,0.500 1.000x0.500

$ move left
workspace splith focus=3
  window 3 0.000,0.000 0.334x1.000
  splitv 0.334,0.000 0.334x1.000
    window 2 0.334,0.000 0.334x1.000
  window 1 0.667,0.000 0.333x1.000

$ fullscreen toggle
workspace splith focus=3
  window 3 0.000,0.000 1.000x1.000
  splitv 0.334,0.000 0.334x1.000
    window 2 0.334,0.000 0.334x1.000 hidden
  window 1 0.667,0.000 0.333x1.000 hidden

$ layout splitv
workspace splith focus=3
  splitv 0.000,0.000 0.000x0.000
    window 3 0.000,0.000 1.000x1.000
    splitv 0.334,0.000 0.334x1.000
      window 2 0.334,0.000 0.334x1.000 hidden
    window 1 0.667,0.000 0.333x1.000 hidden

$ resize shrink down 100 px
workspace splith focus=3
  splitv 0.000,0.000 0.000x0.000
    window 3 0.000,0.000 0.000x0.000
    splitv 0.000,0.000 0.000x0.000
      window 2 0.000,0.000 0.000x0.000 hidden
    window 1 0.000,0.000 0.000x0.000 hidden
