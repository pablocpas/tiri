# a move by a window alone inside a stacked container dissolves the split it just got
# recorded from sway version 1.11

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout stacking
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.037 1.000x0.963

$ split v
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    splitv 0.000,0.075 1.000x0.925
      window 1 0.000,0.037 1.000x0.963

$ move up
workspace splith focus=1
  stacked 0.000,0.000 1.000x1.000
    window 1 0.000,0.037 1.000x0.963
