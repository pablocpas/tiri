# moving a tab sideways inside a nested tabbed container
# recorded from sway version 1.12-8886939 (Aug  5 2026, branch 'HEAD')
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ split v
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ focus parent
workspace splith focus=@1
  window 1 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    window 2 0.500,0.000 0.500x1.000

$ layout tabbed
workspace splith focus=@0/1
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 2 0.000,0.032 1.000x0.968

$ focus parent
workspace splith focus=@0
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 2 0.000,0.032 1.000x0.968

$ split v
workspace splitv focus=@0
  tabbed 0.000,0.000 1.000x1.000
    window 1 0.000,0.032 1.000x0.968 hidden
    splitv 0.000,0.064 1.000x0.936
      window 2 0.000,0.032 1.000x0.968

$ open
workspace splitv focus=3
  tabbed 0.000,0.000 1.000x0.500
    window 1 0.000,0.032 1.000x0.468 hidden
    splitv 0.000,0.064 1.000x0.436
      window 2 0.000,0.032 1.000x0.468
  window 3 0.000,0.500 1.000x0.500

$ move left
workspace splith focus=3
  window 3 0.000,0.000 0.500x1.000
  splitv 0.500,0.000 0.500x1.000
    tabbed 0.500,0.000 0.500x1.000
      window 1 0.500,0.032 0.500x0.968 hidden
      splitv 0.500,0.064 0.500x0.936
        window 2 0.500,0.032 0.500x0.968

$ move right
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    tabbed 0.000,0.000 1.000x1.000
      window 3 0.000,0.032 1.000x0.968
      window 1 0.000,0.032 1.000x0.968 hidden
      splitv 0.000,0.064 1.000x0.936
        window 2 0.000,0.032 1.000x0.968 hidden
