# Splitting after resize and movement preserves sway's exact sibling fractions.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout toggle split
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500

$ open
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.333
    window 2 0.000,0.333 1.000x0.333
    window 3 0.000,0.667 1.000x0.333

$ open
workspace splith focus=4
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.250
    window 2 0.000,0.250 1.000x0.250
    window 3 0.000,0.500 1.000x0.250
    window 4 0.000,0.750 1.000x0.250

$ focus up
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.250
    window 2 0.000,0.250 1.000x0.250
    window 3 0.000,0.500 1.000x0.250
    window 4 0.000,0.750 1.000x0.250

$ split v
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.250
    window 2 0.000,0.250 1.000x0.250
    splitv 0.000,0.500 1.000x0.250
      window 3 0.000,0.500 1.000x0.250
    window 4 0.000,0.750 1.000x0.250

$ move up
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.250
    window 2 0.000,0.250 1.000x0.250
    window 3 0.000,0.500 1.000x0.250
    window 4 0.000,0.750 1.000x0.250

$ layout splith
workspace splith focus=3
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.250x1.000
    window 2 0.250,0.000 0.250x1.000
    window 3 0.500,0.000 0.250x1.000
    window 4 0.750,0.000 0.250x1.000

$ open
workspace splith focus=5
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.200x1.000
    window 2 0.200,0.000 0.200x1.000
    window 3 0.400,0.000 0.200x1.000
    window 5 0.600,0.000 0.200x1.000
    window 4 0.800,0.000 0.200x1.000

$ split v
workspace splith focus=5
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.200x1.000
    window 2 0.200,0.000 0.200x1.000
    window 3 0.400,0.000 0.200x1.000
    splitv 0.600,0.000 0.200x1.000
      window 5 0.600,0.000 0.200x1.000
    window 4 0.800,0.000 0.200x1.000

$ open
workspace splith focus=6
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.200x1.000
    window 2 0.200,0.000 0.200x1.000
    window 3 0.400,0.000 0.200x1.000
    splitv 0.600,0.000 0.200x1.000
      window 5 0.600,0.000 0.200x0.500
      window 6 0.600,0.500 0.200x0.500
    window 4 0.800,0.000 0.200x1.000

$ resize set width 500 px
workspace splith focus=6
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.152x1.000
    window 2 0.152,0.000 0.152x1.000
    window 3 0.305,0.000 0.152x1.000
    splitv 0.457,0.000 0.391x1.000
      window 5 0.457,0.000 0.391x0.500
      window 6 0.457,0.500 0.391x0.500
    window 4 0.848,0.000 0.152x1.000

$ move right
workspace splith focus=6
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.127x1.000
    window 2 0.127,0.000 0.127x1.000
    window 3 0.255,0.000 0.127x1.000
    splitv 0.382,0.000 0.326x1.000
      window 5 0.382,0.000 0.326x1.000
    window 6 0.708,0.000 0.166x1.000
    window 4 0.874,0.000 0.126x1.000

$ split h
workspace splith focus=6
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.127x1.000
    window 2 0.127,0.000 0.127x1.000
    window 3 0.253,0.000 0.127x1.000
    splitv 0.380,0.000 0.326x1.000
      window 5 0.380,0.000 0.326x1.000
    splith 0.705,0.000 0.166x1.000
      window 6 0.705,0.000 0.166x1.000
    window 4 0.872,0.000 0.128x1.000
