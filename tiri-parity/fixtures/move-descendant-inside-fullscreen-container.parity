# A descendant may move and squash wrappers without crossing its fullscreen container boundary.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ layout splitv
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ fullscreen toggle
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 2 0.000,0.500 1.000x0.500 hidden

$ split v
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 1.000x1.000
    window 2 0.000,0.500 1.000x0.500 hidden

$ open
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 1.000x0.500
      window 3 0.000,0.500 1.000x0.500
    window 2 0.000,0.500 1.000x0.500 hidden

$ split v
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x1.000
      splitv 0.000,0.000 1.000x0.500
        window 1 0.000,0.000 1.000x0.500
      window 3 0.000,0.500 1.000x0.500
    window 2 0.000,0.500 1.000x0.500 hidden

$ move up
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    splitv 0.000,0.000 1.000x1.000
      window 1 0.000,0.000 1.000x0.667
      window 3 0.000,0.667 1.000x0.333
    window 2 0.000,0.500 1.000x0.500 hidden
