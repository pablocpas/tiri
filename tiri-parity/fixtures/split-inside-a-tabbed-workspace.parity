# split inside a tabbed workspace keeps the workspace tabbed
# recorded from sway version 1.11
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 1.000x1.000

$ layout tabbed
workspace tabbed focus=@
  window 1 0.000,0.037 1.000x0.963

$ focus child
workspace tabbed focus=1
  window 1 0.000,0.037 1.000x0.963

$ split v
workspace tabbed focus=1
  splitv 0.000,0.075 1.000x0.925
    window 1 0.000,0.037 1.000x0.963
