# the opposite: a move that keeps the containers rather than dissolving them
# recorded from sway version 1.12-8886939 (Aug  5 2026, branch 'HEAD')
# client 400x285

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 1.000x1.000

$ split h
workspace splith focus=@0
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  splith 0.000,0.000 0.500x1.000
    window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ layout stacking
workspace splith focus=2
  stacked 0.000,0.000 1.000x1.000
    splith 0.000,0.128 1.000x0.872
      window 1 0.000,0.064 1.000x0.936 hidden
    window 2 0.000,0.064 1.000x0.936

$ move down
workspace splitv focus=2
  splith 0.000,0.000 1.000x0.500
    stacked 0.000,0.000 1.000x0.500
      splith 0.000,0.064 1.000x0.436
        window 1 0.000,0.032 1.000x0.468
  window 2 0.000,0.500 1.000x0.500
