# climbing out of a floating branch lands in `workspace->floating`, laid out the way the
# workspace is, and the landing raises what it focused to the top of that list.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ split n
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=2
  window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ open
workspace splith focus=3
  window 2 0.000,0.000 0.500x1.000
  window 3 0.500,0.000 0.500x1.000
  window 1 0.344,0.292 0.312x0.417 floating

$ move up
workspace splitv focus=3
  window 3 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 2 0.000,0.500 1.000x0.500
  window 1 0.344,0.292 0.312x0.417 floating

$ floating toggle
workspace splitv focus=3
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating
  window 3 0.344,0.292 0.312x0.417 floating

$ move down
workspace splitv focus=3
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating
  window 3 0.344,0.306 0.312x0.417 floating

$ splitv
workspace splitv focus=3
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000
  window 1 0.344,0.292 0.312x0.417 floating
  splitv 0.344,0.306 0.312x0.417
    window 3 0.344,0.306 0.312x0.417 floating

$ focus down
workspace splitv focus=1
  splith 0.000,0.000 1.000x1.000
    window 2 0.000,0.000 1.000x1.000
  splitv 0.344,0.306 0.312x0.417
    window 3 0.344,0.306 0.312x0.417 floating
  window 1 0.344,0.292 0.312x0.417 floating
