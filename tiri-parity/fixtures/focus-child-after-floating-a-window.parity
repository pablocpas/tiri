# `focus child` from the workspace descends into `ws->tiling` and ignores the float
# (seat_get_active_tiling_child). i3 answers the float here; sway is the reference.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ floating toggle
workspace splith focus=2
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating

$ focus parent
workspace splith focus=@
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating

$ focus child
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000
  window 2 0.344,0.292 0.312x0.417 floating
