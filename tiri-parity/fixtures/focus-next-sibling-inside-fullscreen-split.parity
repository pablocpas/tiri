# `focus next sibling` follows the focused child inside a split created while another tiled
# sibling is hidden behind workspace fullscreen.
# recorded from sway version 1.12-dev
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ fullscreen toggle
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ split vertical
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
  window 2 0.000,0.000 0.000x0.000 hidden

$ open
workspace splith focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 3 0.000,0.500 1.000x0.500
  window 2 0.000,0.000 0.000x0.000 hidden

$ focus next sibling
workspace splith focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 3 0.000,0.500 1.000x0.500
  window 2 0.000,0.000 0.000x0.000 hidden
