# Axis resize grows a floating window around its center, not from its bottom-right corner.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ floating toggle
workspace splith focus=1
  window 1 0.344,0.292 0.312x0.417 floating

$ resize grow height 100 px
workspace splith focus=1
  window 1 0.344,0.222 0.312x0.556 floating
