# Resizing a selected container after changing the layout of a fullscreen branch must preserve
# Sway's pending child boxes.
# recorded from sway version 1.12-8886939 (Aug 21 2026, branch 'HEAD')
# client 400x300

$ open
workspace splith focus=1
  window 1 0.000,0.000 1.000x1.000

$ open
workspace splith focus=2
  window 1 0.000,0.000 0.500x1.000
  window 2 0.500,0.000 0.500x1.000

$ move up
workspace splitv focus=2
  window 2 0.000,0.000 1.000x0.500
  splith 0.000,0.500 1.000x0.500
    window 1 0.000,0.500 1.000x0.500

$ close
workspace splitv focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ layout splitv
workspace splitv focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000

$ open
workspace splitv focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    window 3 0.000,0.500 1.000x0.500

$ splitv
workspace splitv focus=3
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    splitv 0.000,0.500 1.000x0.500
      window 3 0.000,0.500 1.000x0.500

$ focus next
workspace splitv focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x0.500
    splitv 0.000,0.500 1.000x0.500
      window 3 0.000,0.500 1.000x0.500

$ fullscreen toggle
workspace splitv focus=1
  splitv 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
    splitv 0.000,0.500 1.000x0.500
      window 3 0.000,0.500 1.000x0.500 hidden

$ layout default
workspace splitv focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 1.000x1.000
    splitv 0.000,0.500 1.000x0.500
      window 3 0.000,0.500 1.000x0.500 hidden

$ resize grow width 100 px
workspace splitv focus=1
  splith 0.000,0.000 1.000x1.000
    window 1 0.000,0.000 0.000x0.000
    splitv 0.000,0.000 1.000x1.000
      window 3 0.000,0.000 1.000x1.000 hidden
